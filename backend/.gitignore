# .gitignore

# 1. 파이썬 가상환경 및 캐시
.venv/
venv/
__pycache__/
*.pyc

# 2. 리액트 라이브러리 (용량 엄청 큼)
node_modules/
dist/
build/
.env
# .env.backup, .env.local 처럼 비밀키가 든 파생 파일까지 확실히 제외
.env.*

# 3. DB 백업 (학생 개인정보 포함 — 절대 커밋 금지)
backups/

# 4. 로컬 테스트용 SQLite DB (run_local.py / seed_local.py가 만드는 파일 — 운영과 무관)
*.db
*.sqlite3

.DS_Store