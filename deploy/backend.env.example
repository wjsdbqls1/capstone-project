# deploy/backend.env — 백엔드 비밀값. 서버에만 두고 저장소에 올리지 않는다.
# DATABASE_URL·Supabase 설정은 docker-compose.yml이 정하므로 여기 넣지 않는다.

# 로그인 토큰 서명 키이자 공결 서류 링크 서명 키. 바꾸면 모든 사용자가 다시 로그인해야 한다.
JWT_SECRET=
JWT_ALG=HS256

# 웹 푸시 알림 키 (PEM의 줄바꿈은 \n 으로 적는다)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:

# 학과 홈페이지 공지 자동 수집 간격(시간)
NOTICE_SYNC_INTERVAL_HOURS=3

# 값이 있으면 이 사용자 id에게만 알림을 보낸다. 리허설 중에는 0 (아무에게도 안 감)
NOTIFY_ONLY_USER_IDS=
