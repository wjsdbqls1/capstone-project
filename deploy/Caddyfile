# 프론트 정적 파일 서버. HTTPS는 Cloudflare가 맡으므로 여기서는 http(80)만 쓴다.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# 빌드할 때마다 이름이 바뀌는 파일(assets/)은 오래 캐시해도 된다
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# 나머지(index.html, sw.js, 아이콘 등)는 매번 새 버전인지 확인한다.
	# 그래야 배포가 PWA에 바로 반영된다.
	@other not path /assets/*
	header @other Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# /student/home 같은 화면 주소는 실제 파일이 없으므로 index.html을 준다(SPA)
	try_files {path} /index.html
	file_server
}
