# deploy/backup.env — 백업(restic → Cloudflare R2)과 장애 알림 설정. 서버에만 둔다.
# bash와 docker가 함께 읽으므로 값에 따옴표·공백을 쓰지 않는다.

# R2 버킷 sch-cse-task-backup (Cloudflare → R2 → Manage API tokens, Object Read & Write)
RESTIC_REPOSITORY=s3:https://<계정ID>.r2.cloudflarestorage.com/sch-cse-task-backup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# 백업 암호. 이게 없으면 R2의 백업을 아무도 못 연다 → 서버 밖(학과)에도 따로 보관할 것
RESTIC_PASSWORD=

# healthchecks.io 알림 주소 (없으면 알림만 건너뛴다)
HC_HEARTBEAT_URL=
HC_BACKUP_URL=
HC_RESTORE_URL=
